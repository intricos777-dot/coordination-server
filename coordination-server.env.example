# Coordination Server Environment Configuration
# Copy to /etc/coordination-server.env and customize
# 
# Required variables:
#   COORD_JWT_SECRET - Secret for JWT token signing (generate with: openssl rand -hex 64)
#   COORD_ROOT_KEY - Root key for capability signing (generate with: openssl rand -base64 32)
#
# Optional variables:
#   COORD_ADMIN_TOKEN - Admin API token (generate with: openssl rand -hex 32)
#   COORD_TLS_CERT - Path to TLS certificate
#   COORD_TLS_KEY - Path to TLS private key

# ─── Network ────────────────────────────────────────────────────────

COORD_PORT=4126
COORD_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4096,http://127.0.0.1:3000,http://127.0.0.1:4096

# ─── Federation ─────────────────────────────────────────────────────

COORD_NODE_ID=primary
COORD_LISTEN_URL=ws://localhost:4126/ws

# ─── Security ───────────────────────────────────────────────────────

# Generate with: openssl rand -hex 64
COORD_JWT_SECRET=

# Generate with: openssl rand -base64 32
COORD_ROOT_KEY=

# Generate with: openssl rand -hex 32 (optional, enables admin endpoints)
COORD_ADMIN_TOKEN=

# TLS (optional, for HTTPS/WSS)
# COORD_TLS_CERT=/etc/coordination-server/certs/server.crt
# COORD_TLS_KEY=/etc/coordination-server/certs/server.key

# ─── Logging ────────────────────────────────────────────────────────

COORD_LOG_DIR=/var/log/coordination-server
COORD_DATA_DIR=/var/lib/coordination-server
LOG_LEVEL=info
COORD_LOG_LEVEL=info

# ─── Token Expiry ───────────────────────────────────────────────────

COORD_JWT_EXPIRY=24h

# ─── Rate Limiting ──────────────────────────────────────────────────

# COORD_RATE_LIMIT_WINDOW=60000
# COORD_RATE_LIMIT_MAX=100
# COORD_WS_RATE_LIMIT=50

# ─── Peer Discovery (for federation) ────────────────────────────────

# COORD_PEER_URLS=ws://peer1:4126/ws,ws://peer2:4126/ws